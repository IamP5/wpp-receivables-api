# WhatsApp Cloud API (Meta for Developers -> your app -> WhatsApp -> API Setup)
WHATSAPP_ADAPTER=cloud-api            # or "mock" to run the journey without Meta
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=                  # App settings -> Basic -> App secret (validates webhook signatures)
WHATSAPP_VERIFY_TOKEN=change-me       # same value typed in WhatsApp -> Configuration -> Webhook
WHATSAPP_ALLOWED_COUNTRY_CODES=1      # development profile default: the Meta app only reaches US numbers

# Internal API key (X-Api-Key header) for /campaigns and /conversations. Empty disables it.
API_KEY=

# Mock customers bound to your WhatsApp test numbers (E.164 digits, no '+', e.g. 1XXXXXXXXXX for US)
MOCK_CUSTOMER_PHONE=
MOCK_CUSTOMER_NAME=
MOCK_CUSTOMER_2_PHONE=

POSTGRES_HOST=localhost:5432
POSTGRES_DB=receivables
POSTGRES_USER=receivables
POSTGRES_PASSWORD=receivables
